# Copy to backend/.env and fill in. Never commit real values.

# --- App ---
APP_URL=http://localhost:5173
# Long random strings, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
SESSION_SECRET=

# --- Database ---
# Local: plain SQLite file. Production: sqlite+libsql://<db>-<org>.turso.io?secure=true
DATABASE_URL=sqlite:///./portal_boards.db
TURSO_AUTH_TOKEN=

# --- OAuth (callback: {APP_URL}/api/auth/{github|google}/callback) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AI_ENABLED=true
